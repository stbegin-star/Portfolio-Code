        % Button pushed function: SaveTrialDataButton_7
        function SaveTrialDataButton_1Pushed(app, event)
            posErr = app.PositionErrormmEditField.Value;
            velErr = app.VelocitymmsEditField.Value - app.VelocitymmsEditField_2.Value;
            accErr = app.Accelerationmms2EditField.Value - app.Accelerationmms2EditField_2.Value;
            newRow = table(...
                app.TrialCounterEditField_7.Value, ...
                string(app.SpeedDropDown.Value), ...
                string(app.LoadDropDown.Value), ...
                string(app.CyclesDropDown.Value), ...
                posErr,velErr,accErr, ...
                app.PositionmmEditField.Value, ...
                app.VelocitymmsEditField_2.Value, ...
                app.Accelerationmms2EditField_2.Value, ...
                string(app.NotesfromTrialTextArea_7.Value), ...
                'VariableNames',{'Trial','Speed','Load','Cycles','PosErr','VelErr','AccErr','ExpPos','ExpVel','ExpAcc','Notes'});
            if isempty(app.TrialDataTable)
                app.TrialDataTable.Data = newRow;
            else 
                app.TrialDataTable.Data = [app.TrialDataTable.Data; newRow];
            end
            data = app.TrialDataTable.Data;
            n = height(data);
            app.MeanPositionErrormmEditField.Value = mean(data.PosErr);
            app.PositionErrorSDmmEditField.Value = sqrt(sum(data.PosErr.^2)/n);
            app.MeanVelocitymmsEditField.Value = mean(data.VelErr);
            app.VelocitySDmmsEditField.Value = sqrt(sum(data.VelErr.^2)/n);
            app.MeanAccmms2EditField.Value = mean(data.AccErr);
            app.AccSDmms2EditField.Value = sqrt(sum(data.AccErr.^2)/n);
            plot(app.UIAxes,data.Trial,data.PosErr,'-o');
            plot(app.UIAxes_2,data.Trial, data.VelErr,'-o');
            plot(app.UIAxes_3,data.Trial, data.AccErr,'-o');
            app.TrialCounterEditField_7.Value = app.TrialCounterEditField_7.Value + 1;
            app.ClearCurrentTrialEntryButton_1Pushed();
        end

        % Button pushed function: ClearCurrentTrialEntryButton_7
        function ClearCurrentTrialEntryButton_1Pushed(app, event)
            app.PositionErrormmEditField.Value = 0;
            app.VelocitymmsEditField.Value = 0;
            app.Accelerationmms2EditField.Value = 0;
            app.PositionmmEditField.Value = 0;
            app.VelocitymmsEditField_2.Value = 0;
            app.Accelerationmms2EditField_2.Value = 0;
            app.NotesfromTrialTextArea_7.Value = "";
        end

        % Button pushed function: ExportDatatoCSVExcelButton_7
        function ExportDatatoCSVExcelButton_1Pushed(app, event)
            if isempty(app.TrialDataTable)
                uialert(app.UIFigure,'No data to export!','Export Error');
                return;
            end
            [file,path] = uiputfile({'*.csv';'*.xlsx'},'Save Trial Data');
            if isequal(file,0)
                return;
            end
            fullPath = fullfile(path,file)
            summaryHeader = {'','';'Overall Results',''};
            summaryData = {
                'Mean Position Error (mm)',app.MeanPositionErrormmEditField.Value;
                'Position Error SD (mm)', app.PositionErrorSDmmEditField.Value;
                'Mean Velocity Error (mm/s)', app.MeanVelocitymmsEditField.Value;
                'Velocity Error SD (mm/s)', app.VelocitySDmmsEditField.Value;
                'Mean Accel Error (mm/s^2)', app.MeanAccmms2EditField.Value;
                'Accel Error SD (mm/s^2)', app.AccSDmms2EditField.Value};
            finalSummary = [summaryHeader; summaryData];
            writetable(app.TrialDataTable.Data,fullPath);
            writecell(finalSummary, fullPath,'WriteMode','append');
            app.TrialDataTable.Data = [];
            app.TrialCounterEditField_7.Value = 1;
            app.ClearCurrentTrialEntryButton_1Pushed();
            cla(app.UIAxes);
            cla(app.UIAxes_2);
            cla(app.UIAxes_3);
            app.MeanPositionErrormmEditField.Value = 0;
            app.PositionErrorSDmmEditField.Value = 0;
            app.VelocitySDmmsEditField.Value = 0;
            app.MeanVelocitymmsEditField.Value = 0;
            app.AccSDmms2EditField.Value = 0;
            app.MeanAccmms2EditField.Value = 0;
        end

        % Button pushed function: SaveTrialDataButton_8
        function SaveTrialButton_2Pushed(app, event)
            newRow = table(...
                app.TrialCounterEditField_8.Value, ...
                string(app.VacuumPressureDropDown.Value), ...
                string(app.LoweringSpeedDropDown.Value), ...
                app.DiditgripsuccessfullyCheckBox.Value, ...
                app.CoverslipPositionErrormmEditField_2.Value, ...
                app.TimingErrormsEditField.Value, ...
                app.DropPositionErrormmEditField.Value, ...
                app.DropPositionmmEditField.Value, ...
                app.TimetolowerreleasecoverslipEditField.Value, ...
                string(app.NotesfromTrialTextArea_8.Value), ...
                'VariableNames',{'Trial','Vacuum','Speed','GripSuccess','SlipErr','TimingErr','DropErr','ExpDropPos','ExpTime','Notes'});
            if isempty(app.TrialDataTable.Data) || ~istable(app.TrialDataTable.Data)
                app.TrialDataTable.Data = newRow;
            else 
                app.TrialDataTable.Data = [app.TrialDataTable.Data; newRow];
            end
            data = app.TrialDataTable.Data;
            n = height(data);
            app.MeanSlipPositionErrormmEditField.Value = mean(data.SlipErr);
            app.SlipPositionErrorSDmmEditField.Value = sqrt(sum(data.SlipErr.^2)/n);
            app.GripSuccessRateEditField.Value = (sum(data.GripSuccess)/n) * 100;
