       %Retrieve modified data vector for the specified jointTag (e.g.,'RH')
       function data = getJointModifiedData(app, jointTag)
            allMod = vertcat(app.phases.mod);
            jointMap = struct('RH',2,'RK',3,'RA',4,'LH',5,'LK',6,'LA',7);
