            'Knee',struct('Flexion',0,'Extension',157),'Ankle',...
            struct('Flexion',-20,'Extension',25));
        % Mapping from joint abbreviations to joint type categories
        JointToType = struct('RH','Hip','LH','Hip','RK','Knee','LK','Knee', ...
