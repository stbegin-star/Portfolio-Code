       %Set modified data vector into the relevant phases for the specified jointTag 
       function setJointModifiedData(app,jointTag,newData)
           jointMap = struct('RH',2,'RK',3,'RA',4,'LH',5,'LK',6,'LA',7);
           col = jointMap.(jointTag);
           nPhases = numel(app.phases);
           counts = zeros(1,nPhases);
           %Collect number of rows in each phase
           for k = 1:nPhases
               counts(k) = size(app.phases(k).mod,1);
           end
           totalRows = sum(counts);
           if length(newData) ~= totalRows
               error("Length mismatch: expected %d elements, got %d.",...
                   totalRows, length(newData));
           end
           %Split newData vector into phase-sized chunks 
           newDataSplit = mat2cell(newData(:), counts,1);
           %Update phase mod data with corresponding split data
           for k = 1:nPhases
               app.phases(k).mod(:,col) = newDataSplit{k};
           end
       end
       %check if specified max angle value is within safety limits for given joint and direction 
       function tf = validateMaxAngle(app,jointTag, direction,userValue)
           jointType = app.JointToType.(jointTag);
           limits = app.HardLimits.(jointType);
           if strcmp(direction,'Extension')
               limit = limits.Extension
               if userValue > limit 
                   %alert if user attempts to set extension beyond safe limits
                   uialert(app.UIFigure,sprintf('Maximum extension for %s joint is %d degrees.',jointTag,limit), ...
                       'Angle Limit Exceeded');
                   tf = false;
                   return;
               end 
           elseif strcmp(direction,'Flexion')
               limit = limits.Flexion;
               if userValue < limit 
                   %Alert if user attempts to set flexion beyond safe limits
                   uialert(app.UIFigure,sprintf('Maximum flexion for %s joint is %d degrees.',jointTag,limit), ...
                       'Angle Limit Exceeded');
                   tf = false;
                   return;
               end
           end 
           tf = true; %Value is within limits
       end
       %Apply max angle changes to selected joints with scaling of modified data 
       function applyMaxAngle(app)
            directionStr = app.DirectionDropDown.Value; %User selected modification direction
            userVal = app.MaxAngledegEditField.Value; %User input angle value to apply
            isExtension = strcmp(app.DirectionDropDown.Value,'Extension (+)');
            isFlexion = strcmp(app.DirectionDropDown.Value,'Flexion (-)');
            selected = app.getSelectedJoints();
            if isempty(selected)
                uialert(app.UIFigure,'Please select at least one joint.','No Joint Selected');
                return;
            end
            jointMap = struct('RH',2,'RK',3, 'RA',4,'LH',5,'LK',6,'LA',7);
            %Validate each selected joint's new max angle against hard limits
            for idx = 1:numel(selected)
                jointTag = selected{idx};
                dirKey = '';
                valtocheck = userVal;
                if isExtension 
                    dirKey = 'Extension';
                elseif isFlexion
                    dirKey = 'Flexion';
                end
                if isExtension
                    if ~app.validateMaxAngle(jointTag, dirKey,valtocheck)
                        return; %Stop if validation fails
                    end
                elseif ~isFlexion
                    if ~app.validateMaxAngle(jointTag,dirKey,valtocheck)
                        return; %Stop if validation fails
                    end
                end
            end
            %If validation passes, update UI numeric fields 
            for idx = 1:numel(selected)
                jointTag = selected{idx};
                if isExtension
                    app.([jointTag 'Max']).Value = userVal;
                elseif isFlexion
                    app.([jointTag 'Min']).Value = userVal;
                end
            end
            %Save original phase data for selected joints and phases for possible revert
            if ~isstruct(app.previousPlotHandles) || isempty(fieldnames(app.previousPlotHandles))
                app.previousPlotHandles = struct();
            end
            for pIdx = 1:numel(app.phases)
                for i = 1:numel(selected)
                    jt = selected{i};
                    fld = sprintf('%s_P%d',jt,pIdx);
                    col = jointMap.(jt);
                    app.previousPlotHandles.(fld) = app.phases(pIdx).orig(:,col);
                end
            end
            %For each selected joint, scale modified data to new max angle while perserving shape 
            for idx = 1:numel(selected)
                jointTag = selected{idx};
                col = jointMap.(jointTag);
                modData = app.getJointModifiedData(jointTag);
                currentMax = max(modData);
                currentMin = min(modData);
                extMax = app.([jointTag 'Max']).Value;
                flexMin = app.([jointTag 'Min']).Value;
                %Calculate scale factors for positive (Extension) and negative (flexion) parts 
                if currentMax > 0 && extMax > 0
                    scalePos = extMax / currentMax;
                else
                    scalePos = 1;
                end
                if currentMin < 0 && flexMin > 0
                    scaleNeg = (-flexMin) / currentMin;
                else
                    scaleNeg = 1;
                end
                newData = zeros(size(modData));
                posIdx = modData > 0;
                newData(posIdx) = modData(posIdx) * scalePos;
                negIdx = modData < 0;
                newData(negIdx) = modData(negIdx) * scaleNeg;
                zeroIdx = modData == 0;
                newData(zeroIdx) = 0;
                %Set modified data for the joint
                app.setJointModifiedData(jointTag, newData);
            end
            %Redraw plots to reflect changes
            app.drawPlots();
       end
