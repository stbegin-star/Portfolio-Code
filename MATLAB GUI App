        % Button pushed function: ResetModifiedPlotsButton
        function onReset(app, event)
             if ~app.loaded; 
                 return; %No data loaded, nothing to reset
             end
             %Collect joints selected for reset
             toReset = {};
             if app.RHReset.Value, 
                 toReset{end+1} = 'RH';
             end
             if app.RKReset.Value,
                 toReset{end+1} = 'RK';
             end
             if app.RAReset.Value,
                 toReset{end+1} = 'RA';
             end
             if app.LHReset.Value,
                 toReset{end+1} = 'LH';
             end
             if app.LKReset.Value,
                 toReset{end+1} = 'LK';
             end
             if app.LAReset.Value,
                 toReset{end+1} = 'LA';
             end
             %Alert if no joints selected
             if isempty(toReset)
                 uialert(app.UIFigure,'Please select at least one joint to reset.','No Joints Selected');
                 return;
             end
             jointMap = struct('RH',2,'RK',3,'RA',4,'LH',5,'LK',6,'LA',7);
             %Loop over phases and reset mod data to original for selected joints
             for pIdx = 1:numel(app.phases)
                 for i = 1:numel(toReset)
                     jn = toReset{i};
                     col = jointMap.(jn);
                     app.phases(pIdx).mod(:,col) = app.phases(pIdx).orig(:,col);
                 end
             end
             %Redraw plots with data reset
             app.drawPlots();
        end

