        end

        % Button pushed function: LoadPatientTrajectoryButton
        function onLoad(app, event)
            [f, p] = uigetfile('*.mat', 'Select trajectory MAT file');
            if isequal(f, 0)
                return; %User cancelled file selection
            end
            %Load data from file selected by user
            S = load(fullfile(p, f));
            %Verify required fields exist in loaded MAT file
            if ~all(isfield(S, {'WalkP0G', 'WalkP1G', 'WalkP2G'}))
                uialert(app.UIFigure, ...
                    'MAT file must contain WalkP0G, WalkP1G, WalkP2G', ...
                    'Invalid file');
                return;
            end
            %Store original and modified data as identical (initially) structured by phase
            app.phases = struct('name', {'P0', 'P1', 'P2'}, ...
                'orig', {S.WalkP0G, S.WalkP1G, S.WalkP2G}, ...
                'mod',  {S.WalkP0G, S.WalkP1G, S.WalkP2G});
            app.loaded = true; %Mark data as loaded
            % Enable UI controls for manipulation and export
            app.OffsetDegEditField.Enable = 'on';
            app.GainEditField.Enable = 'on';
            app.ResetModifiedPlotsButton.Enable = 'on';
            app.ExportModifiedTrajectoryButton.Enable = 'on';
            % Enable checkboxes for joint visibility
            app.HipJointCheckBox.Enable = 'on';
