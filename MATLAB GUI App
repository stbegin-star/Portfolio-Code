       %Update the percent work done fields based on loaded session data for specified session index
       function updateWorkDoneDisplays(app,sessionIdx)
           if isempty(app.sessionData) || sessionIdx > length(app.sessionData)
               return; %Session index invalid or data not loaded
           end
           %Extract session data struct for given index
           sess = app.sessionData{sessionIdx};
           %Gather gait phase data matrices
           allPhases = {sess.WalkP0G,sess.WalkP1G,sess.WalkP2G};
           leftWork = 0;
           rightWork = 0;
           totalWork = 0;
           %Calculate sums of absolute work for left and right leg joints over all phases
           for i = 1:length(allPhases)
               data = allPhases{i};
               leftWork = leftWork + sum(abs(data(:,5:7)),'all');
               rightWork = rightWork + sum(abs(data(:,2:4)),'all');
               totalWork = totalWork +sum(abs(data(:,2:7)),'all');
           end
           %Calculate percent work done by each leg based on total
           leftPct = 100 * leftWork / totalWork;
           rightPct = 100 * rightWork / totalWork;
           %Update UI numeric gields with rounded percentage values 
           app.LeftLegEditField.Value = round(leftPct,2);
           app.RightLegEditField.Value = round(rightPct,2);
       end 
       %Generate or update overall analysis plots for ROM and work progression across sessions 
       function updateOverallAnalysisPlots(app)
           if isempty(app.sessionData)
               return; %No data available for plotting 
           end
           nSessions = length(app.sessionData);
           jointList = {'RH','RK','RA','LH','LK','LA'};
           nJoints = numel(jointList);
           romPercentGoal = zeros(nSessions+1,nJoints); %ROM percent relative to goal for sessions and baseline 
           percentchangefromoriginal = nan(nSessions,1);
           percentchangefromgoal = nan(nSessions,1);
           workLeft = nan(nSessions+1,1); %Percent work done by left leg PLEGS
           workRight = nan(nSessions+1,1); %Percent work done by right leg PLEGS
           patientworkLeft = nan(nSessions+1,1); %Percent work done by left leg (100% - PLEGS) 
           patientworkRight = nan(nSessions+1,1); %Percent work done by right leg
           origROM = app.getOriginalROM(); %Load baseline ROM angles
           goalROM = app.getGoalROM(); %Load goal ROM angles
           originalMaxAngles = nan(1,nJoints);
           goalMaxAngles = nan(1, nJoints);
           %Extract and clamp original and goal max angles within hardware limits for comparability 
           for idx = 1:nJoints
               joint = jointList{idx};
               maxOrigField = joint + "MaxOrig";
               maxGoalField = joint + "MaxGoal";
               if isfield(origROM,maxOrigField)
                   rawOrigVal = origROM.(maxOrigField);
               else
                   rawOrigVal = NaN;
               end
               if isfield(goalROM,maxGoalField)
                   rawGoalVal = goalROM.(maxGoalField);
               else
                   rawGoalVal = NaN;
               end
               jointType = app.JointToType.(joint);
               limits = app.HardLimits.(jointType);
               minLim = limits.Flexion;
               maxLim = limits.Extension;
               if ~isnan(rawOrigVal)
                   originalMaxAngles(idx) = min(max(rawOrigVal,minLim),maxLim);
               else
                   originalMaxAngles(idx) = NaN;
               end
               if ~isnan(rawGoalVal)
                   goalMaxAngles(idx) = min(max(rawGoalVal,minLim),maxLim);
               else
                   goalMaxAngles(idx) = NaN;
               end
           end
           %Calculate baseline ROM as percent of goal ROM
           for j = 1:nJoints
               if ~isnan(originalMaxAngles(j)) && ~isnan(goalMaxAngles(j)) && goalMaxAngles(j) ~= 0
                   romPercentGoal(1,j) = 100 * originalMaxAngles(j)/goalMaxAngles(j);
               else
                   romPercentGoal(1,j) = NaN;
               end
           end
           %Initialize work and patient work first entries with NaN (baseline)
           workLeft(1) = NaN;
           workRight(1) = NaN;
           patientworkLeft(1) = NaN;
           patientworkRight(1) = NaN;
           %Loop over sessions to compute per-session ROM and work metrics
           for s = 1:nSessions
               sess = app.sessionData{s};
               allPhases = {sess.WalkP0G,sess.WalkP1G,sess.WalkP2G};
               maxAnglesSession = zeros(1,nJoints);
               %Find max absolute angle per joint across all phases in session
               for j = 1:nJoints
                   jointCol = 1 + j;
                   maxVal = -inf;
                   for p = 1:numel(allPhases)
                       maxVal = max(maxVal,max(abs(allPhases{p}(:,jointCol))));
                   end
                   maxAnglesSession(j) = maxVal;
               end
               changesfromorig = nan(1,nJoints);
               changesfromgoal = nan(1,nJoints);
               %Calculate percent change from original and percent of goal ROM achieved
               for j = 1:nJoints
                   if ~isnan(originalMaxAngles(j)) && originalMaxAngles(j) ~= 0
                       changesfromorig(j) = 100 * ((maxAnglesSession(j) - originalMaxAngles(j)) / originalMaxAngles(j));
                   end
                   if ~isnan(goalMaxAngles(j)) && goalMaxAngles(j) ~= 0
                       changesfromgoal(j) = 100 * (maxAnglesSession(j) / goalMaxAngles(j));
                   end
               end
               percentchangefromoriginal(s) = mean(changesfromorig,'omitnan'); %Average across joints ignorning NaN
               percentchangefromgoal(s) = mean(changesfromgoal,'omitnan');
               leftWorkSum = 0;
               rightWorkSum = 0;
               totalWorkSum = 0;
               %Compute work done sums for left and right legs across all phases
               for p = 1:numel(allPhases)
                   d = allPhases{p};
                   leftWorkSum = leftWorkSum + sum(abs(d(:,5:7)),'all');
                   rightWorkSum = rightWorkSum + sum(abs(d(:,2:4)),'all');
                   totalWorkSum = totalWorkSum + sum(abs(d(:,2:7)),'all');
               end
               %Calculate percent work done for PLEGS
               workLeft(s+1) = 100 * leftWorkSum / totalWorkSum;
               workRight(s+1) = 100 * rightWorkSum / totalWorkSum;
               %Calculate percent work done by patient (complement)
               patientWorkLeft(s+1) = 100 - workLeft(s+1);
               patientWorkRight(s+1) = 100 - workRight(s+1);
               %Calculate ROM percent of goal for this session
               for j = 1:nJoints
                   if ~isnan(goalMaxAngles(j)) && goalMaxAngles(j) ~= 0
                       romPercentGoal(s+1,j) = 100 * (maxAnglesSession(j) / goalMaxAngles(j));
                   else
                       romPercentGoal(s+1,j) = NaN;
                   end 
               end
           end
           %Clear and hold for updating work and ROM plots
           cla(app.UIAxes3_2);
           hold(app.UIAxes3_2,'on');
           xValsWork = 1:nSessions;
           %Plot PLEGS work done for left and right legs 
           app.plotHandles.Work.PLEGS.Left = plot(app.UIAxes3_2,xValsWork,workLeft(2:end),'-b','DisplayName','PLEGS Left Leg');
           app.plotHandles.Work.PLEGS.Right = plot(app.UIAxes3_2,xValsWork,workRight(2:end),'-r','DisplayName','PLEGS Right Leg');
           %Plot patient work done for left and right legs
           app.plotHandles.Work.Patient.Left = plot(app.UIAxes3_2,xValsWork,patientWorkLeft(2:end),'--b','DisplayName','Patient Left Leg');
           app.plotHandles.Work.Patient.Right = plot(app.UIAxes3_2,xValsWork,patientWorkRight(2:end),'--r','DisplayName','Patient Right Leg');
           %Add and configure legend and axes colors
           lgdWork = legend(app.UIAxes3_2,'Location','best');
           set(lgdWork,'TextColor','black','Color','white','EdgeColor', 'black');
           app.UIAxes3_2.XColor = 'w';
           app.UIAxes3_2.YColor = 'w';
           app.UIAxes3_2.ZColor = 'w';
           app.UIAxes3_2.Title.Color = 'w';
           app.UIAxes3_2.XLabel.Color = 'w';
           app.UIAxes3_2.YLabel.Color = 'w';
           app.UIAxes3_2.ZLabel.Color = 'w';
           grid(app.UIAxes3_2,'on');
           app.UIAxes3_2.XLim = [1 nSessions];
           app.UIAxes3_2.XTick = xValsWork;
           hold(app.UIAxes3_2,'off');
           %Prepare and plot ROM percent of goal for each joint across all sessions + baseline
           cla(app.UIAxes3);
           hold(app.UIAxes3,'on');
           jointColors = {'r','g','b','c','m','y'};
           jointLabels = {'RH','RK','RA','LH','LK','LA'};
           xValsROM = 0:nSessions;
           app.plotHandles.ROM = gobjects(nJoints,1);
           for j=1:nJoints
               app.plotHandles.ROM(j) = plot(app.UIAxes3,xValsROM,romPercentGoal(:,j),'-','Color', ...
                   jointColors{j},'DisplayName',jointLabels{j},'LineWidth',1.5);
           end 
           lgdRom = legend(app.UIAxes3,'Location','best');
           set(lgdRom,'TextColor','black','Color','white','EdgeColor','black');
           app.UIAxes3.XColor = 'w';
           app.UIAxes3.YColor = 'w';
           app.UIAxes3.ZColor = 'w';
           app.UIAxes3.Title.Color = 'w';
           app.UIAxes3.XLabel.Color = 'w';
           app.UIAxes3.YLabel.Color = 'w';
           app.UIAxes3.ZLabel.Color = 'w';
           grid(app.UIAxes3,'on');
           app.UIAxes3.XLim = [0 nSessions];
           app.UIAxes3.XTick = xValsROM;
           hold(app.UIAxes3,'off');
           %Update visibility of plots based on user checkbox selections
           app.updateVisibility();
       end 
       %Update the data table summarizing sessions with percent changes and work 
       function updateSessionSummaryTable(app)
           if isempty(app.sessionData)
               app.SessionSummaryTable.Data = {};
               return;
           end
           nSessions = length(app.sessionData);
           jointList = {'RH','RK','RA','LH','LK','LA'};
           nJoints = numel(jointList);
           percentChangeFromOriginal = zeros(nSessions,1);
           percentChangeFromGoal = zeros(nSessions,1);
           leftWork = zeros(nSessions,1);
           rightWork = zeros(nSessions,1);
           origROM = app.getOriginalROM();
           goalROM = app.getGoalROM();
           originalMaxAngles = nan(1,nJoints);
           goalMaxAngles = nan(1,nJoints);
           %Extract original and goal max angles 
           for idx = 1:nJoints
               joint = jointList{idx};
               maxOrigField = joint + "MaxOrig";
               maxGoalField = joint + "MaxGoal";
               if isfield(origROM,maxOrigField)
                   originalMaxAngles(idx) = origROM.(maxOrigField);
               end
               if isfield(goalROM,maxGoalField)
                   goalMaxAngles(idx) = goalROM.(maxGoalField);
               end
           end
           %Compute session by session changes and work done for table
           for s = 1:nSessions
               sess = app.sessionData{s};
               allPhases = {sess.WalkP0G,sess.WalkP1G,sess.WalkP2G};
               maxAnglesSession = zeros(1,nJoints);
               %Maximum angle per joint over all phases 
               for j = 1:nJoints
                   col = 1 + j;
                   maxVal = -inf;
                   for p = 1:length(allPhases)
                       maxVal = max(maxVal,max(abs(allPhases{p}(:,col))));
                   end
                   maxAnglesSession(j) = maxVal;
               end
               changesFromOrig = zeros(1,nJoints);
               changesFromGoal = zeros(1,nJoints);
               %Percent changes from original and goal ROM
               for j = 1:nJoints
                   if ~isnan(originalMaxAngles(j)) && originalMaxAngles(j) ~= 0
                       changesFromOrig(j) = 100*((maxAnglesSession(j) - originalMaxAngles(j))/originalMaxAngles(j));
                   else 
                       changesFromOrig(j) = NaN;
                   end
                   if ~isnan(goalMaxAngles(j)) && goalMaxAngles(j) ~= 0
                       changesFromGoal(j) = 100*(maxAnglesSession(j)/goalMaxAngles(j));
                   else
                       changesFromGoal(j) = NaN;
                   end
               end
               percentChangeFromOriginal(s) = mean(changesFromOrig,'omitnan');
               percentChangeFromGoal(s) = mean(changesFromGoal,'omitnan');
               totalWork = 0;
               leftWorkSum = 0;
               rightWorkSum = 0;
               %Sum work done for left and right legs over all phases 
               for p = 1:length(allPhases)
                   d = allPhases{p};
                   leftWorkSum = leftWorkSum + sum(abs(d(:,5:7)),'all');
                   rightWorkSum = rightWorkSum + sum(abs(d(:,2:4)),'all');
                   totalWork = totalWork + sum(abs(d(:,2:7)),'all');
               end
               leftWork(s) = 100 * leftWorkSum / totalWork;
               rightWork(s) = 100 * rightWorkSum / totalWork;
           end 
           %Prepare table with relevant columns for display
           T = table((1:nSessions)',percentChangeFromOriginal,percentChangeFromGoal, ...
               leftWork,rightWork,'VariableNames',{'Session','PctChangeFromOriginal','PctChangeFromGoal','LeftLegWorkPct','RightLegWorkPct'});
           app.SessionSummaryTable.Data = T;
       end 
