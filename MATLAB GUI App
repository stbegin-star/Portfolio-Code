        % Callback function
        function onPhaseChange(app, event)
            value = app.TimeSegmentDropDown.Value;
            %Determine curPhase based on dropdown value prefix 
            if startsWith(value, 'P0')
                app.curPhase = 'P0';
            elseif startsWith(value, 'P1')
                app.curPhase = 'P1';
            elseif startsWith(value, 'P2')
                app.curPhase = 'P2';
            else 
                app.curPhase = 'P2'; %Default to phase P2 if no match
            end
            %Update spinner UI controls to reflect new selection
            app.refreshSpinners();
        end

