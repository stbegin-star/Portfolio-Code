        % Button pushed function: OpenPatientFolderButton
        function onLoadFolder(app, event)
            folderPath = uigetdir(pwd,'Select Patient Data Folder');
            if folderPath == 0
                return; %User cancelled selection
            end
            if ~isfolder(folderPath)
                mkdir(folderPath); %Create folder if it doesn't exist
                uialert(app.UIFigure,sprintf('Folder "%s" did not exist and was created.', folderPath), ...
                    'Folder Created');
            end
            sessionFiles = dir(fullfile(folderPath,'*.mat'));
            if isempty(sessionFiles)
                uialert(app.UIFigure,'No session MAT files found in folder.','No Files');
                return;
            end
            %Store full file paths of session files
            app.sessionFiles = fullfile({sessionFiles.folder},{sessionFiles.name});
            validSessions = {};
            %Load each file and check for required fields for validity
            for k = 1:length(app.sessionFiles)
                dataStruct = load(app.sessionFiles{k});
                if all(isfield(dataStruct, {'WalkP0G','WalkP1G','WalkP2G'}))
                    validSessions{end+1} = struct('WalkP0G',dataStruct.WalkP0G, ...
                        'WalkP1G',dataStruct.WalkP1G,'WalkP2G',dataStruct.WalkP2G);
                elseif all(isfield(dataStruct,{'WalkP0G_mod','WalkP1G_mod','WalkP2G_mod'}))
                    validSessions{end+1} = struct('WalkP0G',dataStruct.WalkP0G_mod,'WalkP1G', ...
                        dataStruct.WalkP1G_mod,'WalkP2G',dataStruct.WalkP2G_mod);
                else 
                    %Warn about invalid files skipped
                    warning('Session file "%s" does not contain required fields. Skipping.',app.sessionFiles{k});
                    continue;
                end
            end 
            app.sessionData = validSessions;
            numSessions = length(app.sessionData);
            if isprop(app,'SessionCountLabel')
                app.SessionCountLabel.Text = sprintf('Sessions: %d', numSessions);
            else 
                uialert(app.UIFigure,sprintf('Loaded %d sessions from folder.', ...
                    numSessions),'Sessions Loaded');
            end
            if numSessions == 0
                uialert(app.UIFigure, 'No valid Session files were loaded from the selected folder.','Load Error');
                return;
            end
            %Initialize phases for first session in loaded data
            app.phases = struct('name',{'P0','P1','P2'},'orig', ...
                {app.sessionData{1}.WalkP0G,app.sessionData{1}.WalkP1G,app.sessionData{1}.WalkP2G}, ...
                'mod',{app.sessionData{1}.WalkP0G,app.sessionData{1}.WalkP1G,app.sessionData{1}.WalkP2G});
            app.loaded = true;
            %Enable UI controls for manipulation and export
            app.OffsetDegEditField.Enable = 'on';
            app.GainEditField.Enable = 'on';
            app.ResetModifiedPlotsButton.Enable = 'on';
            app.ExportModifiedTrajectoryButton.Enable = 'on';
            app.HipJointCheckBox.Enable = 'on';
            app.KneeJointCheckBox.Enable = 'on';
            app.AnkleJointCheckBox.Enable = 'on';
            %Draw plots based on loaded data for first session
            app.drawPlots();
            %Update auxiliary display components with session 1 data
            app.updateWorkDoneDisplays(1);
            app.updateOverallAnalysisPlots();
            app.updateSessionSummaryTable();
        end

        % Button pushed function: ExporttoPatientFolderButton
        function onExportFolder(app, event)
            if ~app.loaded
                uialert(app.UIFigure,'No data loaded','Export Error');
                return;
            end
            if isempty(app.sessionFiles)
                uialert(app.UIFigure,'No folder loaded to export to.','Export Error');
                return;
            end
            folderPath = uigetdir(pwd,'Select Folder to Export Patient Data');
            WalkP0G_mod = app.phases(1).mod;
            WalkP1G_mod = app.phases(2).mod;
            WalkP2G_mod = app.phases(3).mod;
            origROM = app.getOriginalROM();
            goalROM = app.getGoalROM();
            ROMData = struct('Original',origROM,'Goal',goalROM);
            try
                %Save modified trajectory and ROM info as separate files in selected folder
                save(fullfile(folderPath,'ModifiedTrajectories.mat'),'WalkP0G_mod','WalkP1G_mod','WalkP2G_mod');
                save(fullfile(folderPath,'PatientRangeOfMotion.mat'),'ROMData');
                uialert(app.UIFigure,'Patient data exported successfully.','Success','Icon','success');
            catch ME
                uialert(app.UIFigure,['Failed to export patient data: ',ME.message],'Export Error');
            end
        end

