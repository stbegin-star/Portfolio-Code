    % Private helper methods for internal computations and UI updates
    methods (Access = private)
        % Update gain and offset spinner UI controls based on currently selected phase and joint data
        function refreshSpinners(app)
            if ~app.loaded
                return; % Nothing to update if data is not loaded
            end
            % Get indices for currently selected phase and joint
            [pIdx, jIdx] = app.currentIndices();
            %Extract original and modified joint angle data columns (time column is 1, joint cols start at 2) 
            orig = app.phases(pIdx).orig(:, jIdx + 1);
            mod  = app.phases(pIdx).mod(:, jIdx + 1);
            mu  = mean(orig);
            %Calculate scaling factor for gain, clamped to range [10, 300]
            scl = (max(mod) - min(mod)) / (max(orig) - min(orig));
            %Calculate offset as difference in means clipped to [-30, 30]
            off = mean(mod) - mu;
            %Update Gain and Offset UI fields with rounded values 
            app.GainEditField.Value = round(min(max(scl * 100, 10), 300), 1);
            app.OffsetDegEditField.Value  = round(min(max(off, -30), 30), 1);
        end
        %Apply gain and offset tuning to selected joints' modified data
        function applyTuning(app)
            %Get list of joints selected for modification
            selectedJoints = app.getSelectedJoints();
            %Check if no joints are selected, show alert and abort
            if isempty(selectedJoints)
                uialert(app.UIFigure, 'Please select at least one joint','No Joint Selected')
                return;
            end
            %Retrieve gain as decimal fraction(e.g., 150% => 1.5)
            gain = app.GainEditField.Value / 100;
            direction = app.DirectionDropDown.Value;
            %Determine if direction corresponds to extension or flexion modifications
            isExtension = strcmp(direction, 'Extension (+)');
            isFlexion = strcmp(direction,'Flexion (-)');
            if ~(isExtension || isFlexion)
                return; %Invalid direction, do nothing 
            end
            %Map joint labels to data column indices in phase matrices 
            jointMap = struct('RH',2,'RK',3,'RA',4,'LH',5,'LK',6,'LA',7);
            %Initialize previousPlotHandles struct if empty
            if ~isstruct(app.previousPlotHandles) || isempty(fieldnames(app.previousPlotHandles))
                app.previousPlotHandles = struct();
            end
            %Save original data for all phases and selected joints into previousPlotHandles for potential revert/visual comparison 
            for pIdx = 1:numel(app.phases)
                for i = 1:numel(selectedJoints)
                    jn = selectedJoints{i};
                    col = jointMap.(jn);
                    fld = jn + "_P" + pIdx;
                    app.previousPlotHandles.(fld) = app.phases(pIdx).orig(:,col);
                end
            end
            %For each selected joint, apply gain and offset transformation
            for i = 1:length(selectedJoints)
                jointName = selectedJoints{i};
                col = jointMap.(jointName);
                allMod = vertcat(app.phases.mod);
                curData = allMod(:,col);
                mu = mean(curData); %Mean angle for baseline
                newData = zeros(size(curData));
                %Indices for positive, negative, and equal to mean values
                posIdx = (curData > mu);
                negIdx = (curData < mu);
                eqIdx = (curData == mu);
                %Apply gain only to chosen direction part of the data to preserve physiological plausibility
                if isExtension
                    newData(posIdx) = mu + gain * (curData(posIdx) - mu);
                    newData(negIdx) = curData(negIdx);
                    newData(eqIdx) = mu; %Maintain mean for equal entries
                elseif isFlexion
                    newData(negIdx) = mu + gain * (curData(negIdx) - mu);
                    newData(posIdx) = curData(posIdx);
                    newData(eqIdx) = mu;
                end
                %Add offset to entire dataset after gain application
                newData = newData + app.OffsetDegEditField.Value;
                %Clamp modified angle data within allowed safety limits for that joint type
                jointType = app.JointToType.(jointName);
                limits = app.HardLimits.(jointType);
                minLim = limits.Flexion;
                maxLim = limits.Extension;
                newData(newData > maxLim) = maxLim;
                newData(newData < minLim) = minLim;
                %Update modified phase data for this joint
                app.setJointModifiedData(jointName, newData);
            end
        end
        %Retrieve previously stored data for a given jointTag (joint-phase combination)
        function data = getPreviousJointData(app, jointTag)
            if isfield(app.previousPlotHandles, jointTag)
                data = app.previousPlotHandles.(jointTag);
            else
                data = []; %No stored data found for requested jointTag
            end
        end
        %Determine if previous/original trajectory line should be visible based on checked tree nodes
        function tf = shouldShowPrevious(app,jointTag)
            checked = app.Tree.CheckedNodes
            checkedLabels = strings(1, numel(checked));
            for i = 1:numel(checked)
                checkedLabels(i) = checked(i).Text;
            end
            %Show if either the specific joint or 'All Lines' is checked
            tf = any(checkedLabels == jointTag) || any(checkedLabels == "All Lines");
        end
        %Draw current plots (both original and modified) of joint trajectories for left and right legs 
        function drawPlots(app)
            if ~app.loaded
                return; %No data loaded to plot
            end
            % Vertically concatenate phases orig and mod data for seamless plotting
            allOrig = vertcat(app.phases.orig);
            allMod  = vertcat(app.phases.mod);
            %Extract time and joint data columns (time is col1: right leg joints cols 2-4, left leg joints cols 5-7)
            tO  = allOrig(:, 1);
            RL_o = allOrig(:, 2:4);
            LL_o = allOrig(:, 5:7);
            tM  = allMod(:, 1);
            RL_m = allMod(:, 2:4);
            LL_m = allMod(:, 5:7);
            % Clear existing plots and prepare axes for new plots
            axesArr = [app.UIAxes_2, app.UIAxes2_2];
            for ax = axesArr
                cla(ax); %Clear axes
                hold(ax, 'on'); %Hold for multiple lines
            end
            %Initialize storage for plot handles of modified lines 
            app.plotHandles = struct();
            app.plotHandles.LL_mod = gobjects(1,3);   % Left leg modified joint plots
            app.plotHandles.RL_mod = gobjects(1,3);   % Right leg modified joint plots            
            % Initialize cell arrays to hold previous/original line plot handles
            app.plotHandles.RL_prev = cell(1,3);
            app.plotHandles.LL_prev = cell(1,3);
            for j = 1:3
                % Plot right leg modified joint angles with color coding
                app.plotHandles.RL_mod(j) = plot(app.UIAxes2_2, tM, RL_m(:, j), app.jointColors{j}, 'LineWidth', 1.4);
                jointTag = app.jointNames{j};
                %Plot original (previous) lines for right leg if available and toggle visibility appropriately 
                if isfield(app.previousPlotHandles, jointTag + "_P1")
                    prev1 = app.getPreviousJointData(jointTag + "_P1");
                    prev2 = app.getPreviousJointData(jointTag + "_P2");
                    prev3 = app.getPreviousJointData(jointTag + "_P3");
                    prevData = vertcat(prev1(:),prev2(:),prev3(:));
                    tPrev = vertcat(app.phases.orig);
                    tPrev = tPrev(:,1);
                    tPrev = tPrev(:);
                    prevData = prevData(:);
                    minLen = min(length(tPrev),length(prevData));
                    tPrev = tPrev(1:minLen);
                    prevData = prevData(1:minLen);
                    if isempty(app.plotHandles.RL_prev{j}) || ~isvalid(app.plotHandles.RL_prev{j})
                       app.plotHandles.RL_prev{j} = plot(app.UIAxes2_2,tPrev,prevData,...
                        '--','Color',app.jointColors{j},'LineWidth',1.2);
                    end
                    if ~isempty(app.plotHandles.RL_prev{j}) && isvalid(app.plotHandles.RL_prev{j})
                       if app.shouldShowPrevious(jointTag)
                          app.plotHandles.RL_prev{j}.Visible = 'on';
                       else
                          app.plotHandles.RL_prev{j}.Visible = 'off';
                       end
                    end
                end
            end
            for j = 1:3
                %Plot left leg modified joint angles with color coding 
                app.plotHandles.LL_mod(j) = plot(app.UIAxes_2, tM, LL_m(:, j), app.jointColors{j}, 'LineWidth', 1.4);
                jointTag = app.jointNames{j+3};
                %Plot original (previous) lines for left leg if available and toggle visibility appropriately 
                if isfield(app.previousPlotHandles, jointTag + "_P1")
                    prev1 = app.getPreviousJointData(jointTag + "_P1");
                    prev2 = app.getPreviousJointData(jointTag + "_P2");
                    prev3 = app.getPreviousJointData(jointTag + "_P3");
                    prevData = vertcat(prev1(:),prev2(:),prev3(:));
                    tPrev = vertcat(app.phases.orig);
                    tPrev = tPrev(:,1);
                    minLen = min(length(tPrev), length(prevData));
                    tPrev = tPrev(1:minLen);
                    prevData = prevData(1:minLen);
                    if isempty(app.plotHandles.LL_prev{j}) || ~isvalid(app.plotHandles.LL_prev{j})
                        app.plotHandles.LL_prev{j} = plot(app.UIAxes_2,tPrev,prevData,...
                        '--','Color',app.jointColors{j},'LineWidth',1.2)
                        disp("Created dotted line for: " + jointTag);
                    end
                    if ~isempty(app.plotHandles.LL_prev{j}) && isvalid(app.plotHandles.LL_prev{j})
                        if app.shouldShowPrevious(jointTag)
                            app.plotHandles.LL_prev{j}.Visible = 'on';
                        else
                            app.plotHandles.LL_prev{j}.Visible = 'off';
                        end
                    end
                end
            end
            % Add legends for left and right leg plots showing joint names 
            jointLabels = {'Hip','Knee','Ankle'};
            lgd1 = legend(app.UIAxes_2, app.plotHandles.LL_mod,jointLabels, 'Location', 'northeast');
            lgd2 = legend(app.UIAxes2_2, app.plotHandles.RL_mod,jointLabels, 'Location', 'northeast');
            %Set legend appearance to white background and black text/edges for readability
            set([lgd1,lgd2],'TextColor','black','Color','white','EdgeColor','black');
            %Set axes properties: axes colors white on dark background, grid on, labels, and limits 
            for ax = axesArr
                ax.XLim = [0, tM(end)];
                ax.XLabel.String = 'Time [s]';
                ax.XColor = 'w';
                ax.YColor = 'w';
                ax.ZColor = 'w';
                ax.Title.Color = 'w';
                ax.XLabel.Color = 'w';
                ax.YLabel.Color = 'w';
                ax.ZLabel.Color = 'w';
                ax.Box = 'on';
                grid(ax,'on');
                ax.GridColor = [1 1 1] * 0.5;
                ax.GridAlpha = 0.3;
                ax.GridLineStyle = '-';
            end
            %Update visibility of lines based on checkboxes and user preferences 
            app.updateLineVisibility();
            app.displayExtremes(); %Display min/max ranges in UI fields
            app.updatePreviousLineVisibility(); %Update original trajectory lines visibility
        end
      %Update visibility of joint trajectory lines based on checbox states for Hip, knee, and ankle 
      function updateLineVisibility(app)
            % Update line visibility based on checkbox states
            if ~app.loaded || isempty(app.plotHandles)
                return; %No plots to update
            end
            % Hip joint (index 1) visibility toggle
            if app.HipJointCheckBox.Value
                set(app.plotHandles.LL_mod(1), 'Visible', 'on');
                set(app.plotHandles.RL_mod(1), 'Visible', 'on');
            else
                set(app.plotHandles.LL_mod(1), 'Visible', 'off');
                set(app.plotHandles.RL_mod(1), 'Visible', 'off');
            end
            % Knee joint (index 2) visibility toggle 
            if app.KneeJointCheckBox.Value
                set(app.plotHandles.LL_mod(2), 'Visible', 'on');
                set(app.plotHandles.RL_mod(2), 'Visible', 'on');
            else
                set(app.plotHandles.LL_mod(2), 'Visible', 'off');
                set(app.plotHandles.RL_mod(2), 'Visible', 'off');
            end
            
            % Ankle joint (index 3) visibility toggle
            if app.AnkleJointCheckBox.Value
                set(app.plotHandles.LL_mod(3), 'Visible', 'on');
                set(app.plotHandles.RL_mod(3), 'Visible', 'on');
            else
                set(app.plotHandles.LL_mod(3), 'Visible', 'off');
                set(app.plotHandles.RL_mod(3), 'Visible', 'off');
            end
      end
      %Return indices for the current phase and joint selection, used for accessing data matrices
      function [pIdx, jIdx] = currentIndices(app)
            %Convert phase label to index
            pIdx = app.phaseLookup(app.curPhase);
            %Find index of current joint in jointNames list
            jIdx = find(strcmp(app.jointNames, app.curJoint));
      end
      %Helper function to convert phase label into numerical index  
      function idx = phaseLookup(app, ph)
             switch ph
                 case 'P0'
                 idx = 1;
                 case 'P1'
                 idx = 2;
             otherwise
                 idx = 3;
             end
      end
      %Get list of joint names selected via checkboxes for modification
       function selectedJoints = getSelectedJoints(app)
           jointList = {'RH','RK','RA','LH','LK','LA'};
           checkboxFields = {'RHCheckbox','RKCheckbox','RACheckbox',...
               'LHCheckbox','LKCheckbox','LACheckbox'};
           selectedJoints ={};
           for i = 1:numel(jointList)
               if app.(checkboxFields{i}).Value
                   selectedJoints{end+1} = jointList{i};
               end
           end
       end
       %Get list of joints checked in tree control for visualization or modification 
       function joints = getCheckedJoints(app)
           selectedNodes = app.JointTree.CheckedNodes;
           allJointNames = {'RH','RK','RA','LH','LK','LA'};
           joints = {};
           for i = 1:length(selectedNodes)
               nodeText = selectedNodes(i).Text;
               if ismember(nodeText, allJointNames)
                   joints{end+1} = nodeText;
               else
                   joints = allJointNames; %If root or all selected, return all joints 
                   break;
               end
           end
       end
       %Populate UI numeric fields with minimum and maximum values for all joints based on modified data
       function displayExtremes(app)
           if ~app.loaded
               return; %Cannot display if no data loaded 
           end
           %Concatenate all modified phases data vertically for global analysis 
           allMod = vertcat(app.phases.mod);
           t = allMod(:,1);
           jointNames = app.jointNames;
           %Loop through each joint to compute min/max and display
           for j = 1:length(jointNames)
               jointName = jointNames{j};
               y = allMod(:,j+1); %Joint angle column
               ymin = min(y);
               ymax = max(y);
               minFieldName = jointName + "Min"; %Corresponding property name for min value
               maxFieldName = jointName + "Max"; %Corresponding property name for max value
               if isprop(app,minFieldName)
                   app.(minFieldName).Value = round(ymin); %Set min value to UI field
               end
               if isprop(app, maxFieldName)
                   app.(maxFieldName).Value = round(ymax); %Set max value to UI field
               end
           end
       end
       %Get checked joints from tree for display of previous/original lines
