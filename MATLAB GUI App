        % Callback function: Tree
        function updatePreviousLineVisibility(app, event)
            checkedNodes = app.Tree.CheckedNodes;
            checkedLabels = strings(1,numel(checkedNodes));
            for i = 1:numel(checkedNodes)
                checkedLabels(i) = checkedNodes(i).Text;
            end
            showAll = any(checkedLabels == "All Lines");
            showRH = showAll || any(checkedLabels == "RH");
            showRK = showAll || any(checkedLabels == "RK");
            showRA = showAll || any(checkedLabels == "RA");
            showLH = showAll || any(checkedLabels == "LH");
            showLK = showAll || any(checkedLabels == "LK");
            showLA = showAll || any(checkedLabels == "LA");
            %Update visibility of right leg previous plot lines (hip, knee, ankle)
            for i = 1:3
                h = app.plotHandles.RL_prev{i};
                if ~isempty(h) && isvalid(h)
                    switch i
                        case 1, h.Visible = iff(showRH, 'on','off');
                        case 2, h.Visible = iff(showRK,'on','off');
                        case 3, h.Visible = iff(showRA, 'on','off');
                    end
                end
            end
            %Update visibility of left leg previous plot lines (hip, knee, ankle)
            for i = 1:3
                h = app.plotHandles.LL_prev{i};
                if ~isempty(h) && isvalid(h)
                    switch i
                        case 1, h.Visible = iff(showLH,'on','off');
                        case 2, h.Visible = iff(showLK,'on','off');
                        case 3, h.Visible = iff(showLA,'on', 'off');
                    end
                end
            end
            function v = iff(cond,a,b)
                if cond
                    v = a;
                else
                    v = b;
                end
            end
                  
        end

