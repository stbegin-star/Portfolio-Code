    [~, idxGammaHigh] = min(abs(FREQ - 40));
    idx_gamma = idxGammaLow:idxGammaHigh;
    
    diff_delta = mean(SPEC_post(:,idx_delta(1):idx_delta(2)),2) - mean(SPEC_pre(:,idx_delta(1):idx_delta(2)),2);
    diff_theta = mean(SPEC_post(:,idx_theta(1):idx_theta(2)),2) - mean(SPEC_pre(:,idx_theta(1):idx_theta(2)),2);
    diff_alpha = mean(SPEC_post(:,idx_alpha(1):idx_alpha(2)),2) - mean(SPEC_pre(:,idx_alpha(1):idx_alpha(2)),2);
    diff_beta = mean(SPEC_post(:,idx_beta(1):idx_beta(2)),2) - mean(SPEC_pre(:,idx_beta(1):idx_beta(2)),2);
    diff_gamma = mean(SPEC_post(:,idx_gamma(1):idx_gamma(2)),2) - mean(SPEC_pre(:,idx_gamma(1):idx_gamma(2)),2);
    %Mapping
    subj_delta = nan(numel(template20),1);
    subj_theta = nan(numel(template20),1);
    subj_alpha = nan(numel(template20),1);
    subj_beta = nan(numel(template20),1);
    subj_gamma = nan(numel(template20),1);

    for k = 1:numel(commonChans)
        lbl = commonChans{k};
        tidx = find(strcmpi(template20,lbl),1);
        if ~isempty(tidx)
            subj_delta(tidx) = diff_delta(k);
            subj_theta(tidx) = diff_theta(k);
            subj_alpha(tidx) = diff_alpha(k);
            subj_beta(tidx) = diff_beta(k);
            subj_gamma(tidx) = diff_gamma(k);
        end
    end

    all_delta(:,s) = subj_delta;
    all_theta(:,s) = subj_theta;
    all_alpha(:,s) = subj_alpha;
    all_beta(:,s) = subj_beta;
    all_gamma(:,s) = subj_gamma;
end

group_delta = nanmean(all_delta,2);
group_theta = nanmean(all_theta,2);
group_alpha = nanmean(all_alpha,2);
group_beta = nanmean(all_beta,2);
group_gamma = nanmean(all_gamma,2);

%Plotting
figure("Name","Group Average EEG Band Differences","Position",[100 100 800 1200]);
clims = {[-10 10],[-5 5],[-5 5],[-5 5],[-5 5]};
group_data = {group_delta,group_theta,group_alpha,group_beta,group_gamma};
titles = {'delta','theta','alpha','beta','gamma'};
for i = 1:5
    subplot(5,1,i)
    data = group_data{i};
    topoplot(data,templatechanlocs,'electrodes','off','maplimits',clims{i});
    title(titles{i},'FontWeight','bold','FontSize',14);
    colorbar
    colormap(jet);
